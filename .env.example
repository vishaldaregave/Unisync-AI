# UniSync AI — environment template.
# Copy to `.env` and fill in. NEVER commit `.env`.
# Values below are local-development placeholders and are not secrets.

# --- Application --------------------------------------------------------
ENV=local
APP_NAME=UniSync AI
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# --- PostgreSQL ---------------------------------------------------------
# Compose boots a single superuser (`postgres`) so that the first migration
# can provision the two roles v2 requires (owner + runtime). Those roles are
# created in Phase 1; they do not exist yet.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=unisync
POSTGRES_SUPERUSER_PASSWORD=postgres

POSTGRES_OWNER_USER=unisync_owner
POSTGRES_OWNER_PASSWORD=local-owner-placeholder
POSTGRES_APP_USER=unisync_app
POSTGRES_APP_PASSWORD=local-app-placeholder

# Runtime role: subject to RLS. Used by the API and workers.
DATABASE_URL=postgresql+asyncpg://unisync_app:local-app-placeholder@localhost:5432/unisync
# Owner role: runs migrations, BYPASSRLS. Never given to the API process.
MIGRATION_DATABASE_URL=postgresql+psycopg://unisync_owner:local-owner-placeholder@localhost:5432/unisync

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Sessions (v2 §13.5-E2) ---------------------------------------------
# Distinct key material per purpose. Do not reuse one value for all three.
JWT_SIGNING_KEY=local-jwt-signing-placeholder-change-me
AUDIT_HMAC_KEY=local-audit-hmac-placeholder-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=unisync
JWT_AUDIENCE=unisync-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- LLM (NOT USED IN M1a) ----------------------------------------------
# M1a makes zero model calls. This stays false until M1b. When false, any
# external provider must refuse to initialise (v2 §13.5-E5.3).
ALLOW_EXTERNAL_LLM=false
